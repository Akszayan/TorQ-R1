<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze_world">
    <!-- Physics engine settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim 8 plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Directional Sun Lighting with Shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.25 -1.0</direction>
    </light>

    <!-- Ambient Fill Light for clear indoor visibility -->
    <light type="point" name="fill_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>-4 -4 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>
    <light type="point" name="fill_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>4 4 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ground Floor with clean indoor surface -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>35 35</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>35 35</size></plane></geometry>
          <material>
            <ambient>0.82 0.84 0.84 1.0</ambient>
            <diffuse>0.82 0.84 0.84 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OUTER BOUNDARY WALLS (16m x 16m) ==================== -->
    <!-- North Wall -->
    <model name="wall_north"><static>true</static><pose>0 8.0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>16.2 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.2 0.2 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south"><static>true</static><pose>0 -8.0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>16.2 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.2 0.2 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east"><static>true</static><pose>8.0 0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 16.0 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16.0 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west"><static>true</static><pose>-8.0 0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 16.0 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16.0 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== INTERIOR MAZE PARTITIONS ==================== -->
    <!-- South-West Internal Divider (Creates Spawn Corridor & South Hallway) -->
    <model name="inner_wall_sw_1"><static>true</static><pose>-4.0 -6.2 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.6 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.6 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Corridor Vertical Wall (separates West loop from Central Rooms) -->
    <model name="inner_wall_w_vert"><static>true</static><pose>-5.8 -0.5 0.6 0 0 1.5707963</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>7.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North-West Chamber Dividing Wall -->
    <model name="inner_wall_nw_horiz"><static>true</static><pose>-4.5 4.5 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Northern Long Highway Wall (Separates North Corridor from Central Area) -->
    <model name="inner_wall_n_highway"><static>true</static><pose>1.5 5.5 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>9.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central North-South Main Spine -->
    <model name="inner_wall_center_vert_1"><static>true</static><pose>-1.5 1.5 0.6 0 0 1.5707963</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>4.5 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.5 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central Horizontal Divider with Doorway -->
    <model name="inner_wall_center_horiz"><static>true</static><pose>1.0 1.0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.4 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East-Central Vertical Wall -->
    <model name="inner_wall_ec_vert"><static>true</static><pose>4.5 2.0 0.6 0 0 1.5707963</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South-East Chamber Horizontal Wall -->
    <model name="inner_wall_se_horiz"><static>true</static><pose>4.0 -3.5 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>4.5 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.5 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Center Dividing T-Wall -->
    <model name="inner_wall_sc_vert"><static>true</static><pose>0.5 -5.2 0.6 0 0 1.5707963</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.5 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.5 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Center-South Zig-Zag Barrier -->
    <model name="inner_wall_cs_horiz"><static>true</static><pose>-2.5 -2.5 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.65 0.75 1</ambient><diffuse>0.55 0.65 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North-East Loop Baffle Wall -->
    <model name="inner_wall_ne_baffle"><static>true</static><pose>6.2 5.0 0.6 0 0 1.5707963</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 1.2</size></box></geometry>
          <material><ambient>0.52 0.62 0.72 1</ambient><diffuse>0.52 0.62 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== PILLARS & COLUMNS ==================== -->
    <!-- Blue Column (Central Atrium) -->
    <model name="pillar_blue_atrium"><static>true</static><pose>1.5 -1.0 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.28</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.20 0.45 0.75 1</ambient><diffuse>0.20 0.45 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Teal Column (North Corridor Intersection) -->
    <model name="pillar_teal_north"><static>true</static><pose>-2.5 6.7 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.15 0.65 0.60 1</ambient><diffuse>0.15 0.65 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cylinder in South-East Room -->
    <model name="pillar_se_room"><static>true</static><pose>6.2 -5.8 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.30</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.30</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.25 0.55 0.70 1</ambient><diffuse>0.25 0.55 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Column in North-West Room -->
    <model name="pillar_nw_room"><static>true</static><pose>-4.0 2.5 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.30 0.60 0.50 1</ambient><diffuse>0.30 0.60 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== CRATES & TABLES (Obstacle Objects) ==================== -->
    <!-- Table / Long Box (Reference Image Aesthetic) -->
    <model name="table_center"><static>true</static><pose>3.0 -1.5 0.4 0 0 0.3</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.6 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.8 0.8</size></box></geometry>
          <material><ambient>0.85 0.65 0.25 1</ambient><diffuse>0.85 0.65 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Crate near East Wall -->
    <model name="crate_east"><static>true</static><pose>6.5 0.5 0.35 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.75 0.50 0.25 1</ambient><diffuse>0.75 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Crate in South Hallway -->
    <model name="crate_south"><static>true</static><pose>-2.0 -7.0 0.3 0 0 0.4</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.65 0.45 0.25 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
