<?xml version="1.0"?>
<robot name="ack" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Base link (Chassis) - Default TorQ-R1 Model -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00186669751054189 3.0253386351986E-05 -0.00605296088229322"/>
      <mass value="0.961047465616957"/>
      <inertia ixx="8.55867486364231E-04" ixy="3.41346959938296E-08" ixz="1.64755227278164E-05" iyy="2.77248181555496E-03" iyz="-2.95282759133104E-08" izz="3.44246448853775E-03"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/base_link.STL"/>
      </geometry>
      <material name="chassis_mat"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheel LF (Front Left) -->
  <link name="wheel_lf_Link">
    <inertial>
      <origin rpy="0 0 0" xyz="1.65897579444685E-06 -0.00270913022688685 -1.5546673051009E-06"/>
      <mass value="0.052873083503169"/>
      <inertia ixx="1.00371783485335E-05" ixy="4.93900109379125E-11" ixz="7.42104604492639E-10" iyy="1.67620175120314E-05" iyz="-5.47583950457701E-11" izz="1.00370342405297E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/wheel_lf_Link.STL"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0315"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_lf_Joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.06679 0.069739 -0.0283"/>
    <parent link="base_link"/>
    <child link="wheel_lf_Link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <!-- Wheel RF (Front Right) -->
  <link name="wheel_rf_Link">
    <inertial>
      <origin rpy="0 0 0" xyz="-1.48986965733955E-06 0.0027090575018239 1.16299057125596E-06"/>
      <mass value="0.052873548617242"/>
      <inertia ixx="1.00360241846408E-05" ixy="-5.83065201444192E-11" ixz="-8.3023958781985E-11" iyy="1.67622954977732E-05" iyz="6.31638512668579E-11" izz="1.00384960556047E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/wheel_rf_Link.STL"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0315"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_rf_Joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.066794 -0.069739 -0.0283"/>
    <parent link="base_link"/>
    <child link="wheel_rf_Link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <!-- Wheel LB (Rear Left) -->
  <link name="wheel_lb_Link">
    <inertial>
      <origin rpy="0 0 0" xyz="1.62806317080544E-06 -0.00317716794378092 -1.54238045318306E-06"/>
      <mass value="0.0571078161230754"/>
      <inertia ixx="1.01056035703468E-05" ixy="4.60479373806495E-11" ixz="7.43896782806142E-10" iyy="1.67990600599721E-05" iyz="-5.763890541079E-11" izz="1.01072652738793E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/wheel_lb_Link.STL"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0315"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_lb_Joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.070313 0.07014 -0.0283"/>
    <parent link="base_link"/>
    <child link="wheel_lb_Link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <!-- Wheel RB (Rear Right) -->
  <link name="wheel_rb_Link">
    <inertial>
      <origin rpy="0 0 0" xyz="-1.50804700475154E-06 0.00317707027691583 1.18963606317302E-06"/>
      <mass value="0.0571078005024283"/>
      <inertia ixx="1.01044417409685E-05" ixy="-5.83065201444192E-11" ixz="-7.56886841840775E-11" iyy="1.67993271276785E-05" iyz="6.31638424138502E-11" izz="1.01087182681654E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/wheel_rb_Link.STL"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0315"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_rb_Joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.07031 -0.07014 -0.0283"/>
    <parent link="base_link"/>
    <child link="wheel_rb_Link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <!-- Central Differential Drive Wheels (True Differential Pivoting Mechanism) -->
  <link name="drive_wheel_left">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="1.6e-5" ixy="0" ixz="0" iyy="2.5e-5" iyz="0" izz="1.6e-5"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.033"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_wheel_left_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 0.070 -0.0283"/>
    <parent link="base_link"/>
    <child link="drive_wheel_left"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="drive_wheel_right">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="1.6e-5" ixy="0" ixz="0" iyy="2.5e-5" iyz="0" izz="1.6e-5"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.033"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_wheel_right_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 -0.070 -0.0283"/>
    <parent link="base_link"/>
    <child link="drive_wheel_right"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <!-- Depth Camera - Default TorQ-R1 Model -->
  <link name="depth_cam">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0023402290651429 0.00113784597946548 -0.0102127064032341"/>
      <mass value="0.0270474748429678"/>
      <inertia ixx="1.43718505822118E-05" ixy="1.24779382573379E-07" ixz="1.29836477956744E-08" iyy="1.65912768209848E-06" iyz="2.28291478579102E-08" izz="1.45615925510082E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/cam_Link.STL"/>
      </geometry>
      <material name="cam_mat"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/cam_Link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="cam_Joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.064015 -0.00013463 0.051155"/>
    <parent link="base_link"/>
    <child link="depth_cam"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- LiDAR Frame - Default TorQ-R1 Model -->
  <link name="lidar_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="8.65086433231368E-05 9.02624784523964E-05 -0.0183546134614858"/>
      <mass value="0.0405423044068563"/>
      <inertia ixx="4.98470776877503E-06" ixy="-1.54076264166869E-07" ixz="2.05182706824286E-09" iyy="5.03926730822203E-06" iyz="1.1006285118993E-08" izz="8.25645669548359E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/lidar_Link.STL"/>
      </geometry>
      <material name="lidar_mat"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://torq_r1_description/meshes/acker/lidar_Link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_Joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0096019 -8.533E-05 0.092501"/>
    <parent link="base_link"/>
    <child link="lidar_frame"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Gazebo Friction & Material Definitions for Default Model -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.22 0.24 0.26 1.0</ambient>
        <diffuse>0.22 0.24 0.26 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wheel_lf_Link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.15 0.15 0.15 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wheel_rf_Link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.15 0.15 0.15 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wheel_lb_Link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.15 0.15 0.15 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wheel_rb_Link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.15 0.15 0.15 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="drive_wheel_left">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>

  <gazebo reference="drive_wheel_right">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>100000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.005</minDepth>
  </gazebo>

  <gazebo reference="depth_cam">
    <visual>
      <material>
        <ambient>0.15 0.24 0.38 1.0</ambient>
        <diffuse>0.18 0.28 0.45 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="lidar_frame">
    <visual>
      <material>
        <ambient>0.18 0.18 0.22 1.0</ambient>
        <diffuse>0.22 0.22 0.26 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- IMU -->
  <xacro:include filename="$(find torq_r1_description)/urdf/imu.urdf.xacro"/>

</robot>
