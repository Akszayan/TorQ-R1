<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <gazebo>
    <!-- True Differential Drive Plugin (Actuation) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Left side wheels -->
      <left_joint>drive_wheel_left_joint</left_joint>
      <left_joint>wheel_lf_Joint</left_joint>
      <left_joint>wheel_lb_Joint</left_joint>

      <!-- Right side wheels -->
      <right_joint>drive_wheel_right_joint</right_joint>
      <right_joint>wheel_rf_Joint</right_joint>
      <right_joint>wheel_rb_Joint</right_joint>

      <!-- Calibrated Kinematic Track Width for Real Differential Drive Dynamics -->
      <wheel_separation>0.140</wheel_separation>
      <wheel_radius>0.033</wheel_radius>

      <!-- Limits & tuning (Smooth, controllable differential drive dynamics) -->
      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>25.0</max_wheel_acceleration>
      <max_linear_acceleration>8.0</max_linear_acceleration>
      <max_angular_acceleration>8.0</max_angular_acceleration>
      <min_linear_velocity>-2.5</min_linear_velocity>
      <max_linear_velocity>2.5</max_linear_velocity>
      <min_angular_velocity>-8.0</min_angular_velocity>
      <max_angular_velocity>8.0</max_angular_velocity>

      <!-- Topics (DiffDrive handles motor control; odometry is handled by OdometryPublisher) -->
      <topic>cmd_vel</topic>
      <odom_topic>diff_drive/odom</odom_topic>
      <tf_topic>diff_drive/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Ground-Truth Physics Odometry Publisher: 100% Synced Gazebo <-> RViz <-> SLAM -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>

    <!-- Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_lf_Joint</joint_name>
      <joint_name>wheel_rf_Joint</joint_name>
      <joint_name>wheel_lb_Joint</joint_name>
      <joint_name>wheel_rb_Joint</joint_name>
      <joint_name>drive_wheel_left_joint</joint_name>
      <joint_name>drive_wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
